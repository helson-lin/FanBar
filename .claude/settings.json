{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking AGENTS.md rules"
          }
        ]
      }
    ]
  }
}
