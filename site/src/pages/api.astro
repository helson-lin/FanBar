---
import { ArrowUpRight, FileJson2, HeartPulse, ListTree } from "lucide-astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  apiCatalogUrl,
  apiDocsUrl,
  apiMarkdownUrl,
  apiUpdated,
  healthApiUrl,
  openApiUrl,
  productApiUrl,
} from "@/lib/api";
import { getDictionary } from "@/lib/i18n";
import { siteUrl } from "@/lib/seo";

const locale = "en" as const;
const dict = getDictionary(locale);
const title = "FanBar Product Facts API";
const description =
  "Discover FanBar's public read-only product facts API, OpenAPI description, health endpoint, and RFC 9727 API catalog.";
const endpoints = [
  {
    icon: FileJson2,
    name: "Product facts",
    method: "GET",
    url: productApiUrl,
    path: "/api/product.json",
    description: "Canonical product, compatibility, installation, feature, and safety facts.",
  },
  {
    icon: HeartPulse,
    name: "Publication status",
    method: "GET",
    url: healthApiUrl,
    path: "/api/health.json",
    description: "A small status document confirming that the static API is available.",
  },
] as const;
---

<BaseLayout
  locale={locale}
  dict={dict}
  seo={{
    title,
    description,
    ogDescription: description,
    canonical: apiDocsUrl,
    markdownUrl: apiMarkdownUrl,
    alternates: [
      { lang: "en", href: apiDocsUrl },
      { lang: "x-default", href: apiDocsUrl },
    ],
    keywords: ["FanBar API", "FanBar product facts", "FanBar OpenAPI", "RFC 9727 API catalog"],
    structuredData: {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description,
      url: apiDocsUrl,
      dateModified: apiUpdated,
      isPartOf: { "@id": `${siteUrl}/#website` },
    },
    preloadHero: false,
    ogType: "article",
    publishedTime: apiUpdated,
    modifiedTime: apiUpdated,
  }}
>
  <Nav locale={locale} dict={dict} />

  <main>
    <article>
      <header class="mx-auto max-w-5xl px-6 pt-14 pb-16 sm:px-8 md:pt-20 md:pb-20">
        <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="transition-colors hover:text-foreground">FanBar</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-foreground">API</li>
          </ol>
        </nav>

        <div class="mt-10 max-w-4xl">
          <SectionLabel>Agent-ready data</SectionLabel>
          <h1 class="mt-6 font-display text-[2.65rem] leading-[1.08] tracking-[-0.02em] sm:text-5xl md:text-[3.5rem]">
            FanBar facts, <span class="gradient-text">without scraping the page.</span>
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
            This public, read-only API gives tools and agents a small canonical source for FanBar
            product, compatibility, installation, and safety facts. No key or account is required.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
            <span>Updated <time datetime={apiUpdated}>October 12, 2026</time></span>
            <span aria-hidden="true">·</span>
            <a href={apiMarkdownUrl} class="underline decoration-border underline-offset-4 hover:text-foreground">Read as Markdown</a>
          </div>
        </div>
      </header>

      <section class="border-y border-border bg-card">
        <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 md:py-20">
          <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
            <div>
              <SectionLabel>Endpoints</SectionLabel>
              <h2 class="mt-4 font-display text-3xl tracking-[-0.01em]">A deliberately small surface</h2>
              <p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">
                Responses are static JSON over HTTPS. They contain no personal data and expose no
                write operations or device-control capability.
              </p>
            </div>

            <div class="divide-y divide-border border-y border-border">
              {endpoints.map(({ icon: Icon, name, method, url, path, description: endpointDescription }) => (
                <a
                  href={url}
                  class="group grid gap-3 py-6 transition-colors hover:text-accent sm:grid-cols-[auto_1fr_auto] sm:items-start sm:gap-4"
                >
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-[10px] border border-border bg-background text-accent">
                    <Icon class="h-5 w-5" aria-hidden="true" />
                  </span>
                  <span>
                    <span class="flex flex-wrap items-center gap-2">
                      <strong class="text-foreground">{name}</strong>
                      <span class="rounded-full bg-muted px-2 py-0.5 font-mono text-[11px] text-muted-foreground">{method}</span>
                    </span>
                    <code class="mt-1 block break-all font-mono text-xs text-muted-foreground">{path}</code>
                    <span class="mt-2 block text-sm leading-relaxed text-muted-foreground">{endpointDescription}</span>
                  </span>
                  <ArrowUpRight class="hidden h-4 w-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 sm:block" aria-hidden="true" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-5xl px-6 py-16 sm:px-8 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
          <div>
            <SectionLabel>Discovery</SectionLabel>
            <h2 class="mt-4 font-display text-3xl tracking-[-0.01em]">Standards-based entry points</h2>
            <p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">
              The catalog follows RFC 9727 Linkset JSON. The service description uses OpenAPI 3.1.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <a href={apiCatalogUrl} class="group rounded-xl border border-border bg-card p-5 transition-colors hover:border-accent/45">
              <ListTree class="h-5 w-5 text-accent" aria-hidden="true" />
              <h3 class="mt-4 font-semibold">API catalog</h3>
              <code class="mt-2 block break-all font-mono text-xs leading-relaxed text-muted-foreground">/.well-known/api-catalog</code>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Linkset JSON with service description, documentation, and status relations.</p>
            </a>
            <a href={openApiUrl} class="group rounded-xl border border-border bg-card p-5 transition-colors hover:border-accent/45">
              <FileJson2 class="h-5 w-5 text-accent" aria-hidden="true" />
              <h3 class="mt-4 font-semibold">OpenAPI description</h3>
              <code class="mt-2 block break-all font-mono text-xs leading-relaxed text-muted-foreground">/openapi.json</code>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Machine-readable operations and response schemas for the published endpoints.</p>
            </a>
          </div>
        </div>
      </section>

      <section class="border-y border-border bg-[#0d172b] text-white">
        <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 md:py-20">
          <p class="font-mono text-xs uppercase tracking-[0.12em] text-white/55">Example</p>
          <h2 class="mt-4 font-display text-3xl">Request the canonical product facts</h2>
          <pre class="mt-7 overflow-x-auto rounded-xl border border-white/15 bg-white/[0.06] p-5 text-sm leading-7 text-white/80"><code>curl https://fanbar.jarin.me/api/product.json</code></pre>
        </div>
      </section>
    </article>
  </main>

  <Footer locale={locale} dict={dict} />
</BaseLayout>
