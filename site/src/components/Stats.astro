---
import type { Dictionary, Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const label = locale === "en" ? "FanBar facts" : "FanBar 数据";
---

<section class="border-y border-border" aria-label={label}>
  <div class="reveal reveal-stagger mx-auto grid max-w-5xl grid-cols-2 gap-6 px-6 py-12 sm:px-8 md:grid-cols-4">
    {dict.stats.map((stat) => (
      <div>
        <div class="font-display text-3xl">{stat.value}</div>
        <div class="mt-1 text-sm text-muted-foreground">{stat.label}</div>
      </div>
    ))}
  </div>
</section>
