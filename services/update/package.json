{
  "name": "fanbar-update-service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "check": "wrangler types --include-runtime=false --strict-vars=false --check && tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply fanbar-compatibility --local",
    "dry-run": "wrangler deploy --dry-run --env production",
    "deploy": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.150.0"
  }
}
