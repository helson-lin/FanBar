{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fanbar-update-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "development",
    "APPCAST_URL": "https://github.com/helson-lin/FanBar/releases/latest/download/appcast.xml",
    "FIRST_COHORT_WEEK": "2026-W46",
    "STATS_ORIGIN": "https://getfanbar.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fanbar-compatibility",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations_update"
    }
  ],
  "ratelimits": [
    {
      "name": "COUNT_LIMIT",
      "namespace_id": "81007",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": { "crons": ["23 4 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "secrets": { "required": ["LIMIT_SALT"] },
  "env": {
    "production": {
      "name": "fanbar-update",
      "routes": [{ "pattern": "update.getfanbar.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "APPCAST_URL": "https://github.com/helson-lin/FanBar/releases/latest/download/appcast.xml",
        "FIRST_COHORT_WEEK": "2026-W46",
        "STATS_ORIGIN": "https://getfanbar.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fanbar-compatibility",
          // Shares the fanbar-compatibility database: the account is at its D1 limit.
          // Table names do not overlap, and migrations are tracked in their own table.
          "database_id": "296396fc-79f2-4a04-99f8-480467d1b694",
          "migrations_dir": "migrations",
          "migrations_table": "d1_migrations_update"
        }
      ],
      "ratelimits": [
        {
          "name": "COUNT_LIMIT",
          "namespace_id": "81008",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "secrets": { "required": ["LIMIT_SALT"] }
    }
  }
}
