{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "reportID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "device": {
      "type": "object",
      "properties": {
        "modelIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "allOf": [
            {
              "type": "string",
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*[0-9]+,[0-9]+$|^unknown$"
            }
          ]
        },
        "processor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "macOSVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "allOf": [
            {
              "type": "string",
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._+-]+$"
            }
          ]
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "allOf": [
            {
              "type": "string",
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._+-]+$"
            }
          ]
        },
        "helperVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "allOf": [
            {
              "type": "string",
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._+-]+$"
            }
          ]
        }
      },
      "required": [
        "modelIdentifier",
        "processor",
        "macOSVersion",
        "appVersion",
        "helperVersion"
      ],
      "additionalProperties": false
    },
    "fanCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "capabilities": {
      "minItems": 7,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "cpuTemperature",
              "gpuTemperature",
              "ssdTemperature",
              "batteryTemperature",
              "fanReadings",
              "manualControl",
              "smartCooling"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "notApplicable",
              "notDetected",
              "temporarilyUnavailable",
              "requiresAuthorization",
              "unverified",
              "requestSucceeded",
              "requestFailed"
            ]
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "SENSOR_READ_SUCCEEDED",
              "SENSOR_NOT_DETECTED",
              "NO_BUILT_IN_BATTERY",
              "FAN_READ_SUCCEEDED",
              "NO_FANS_REPORTED",
              "FAN_READ_FAILED",
              "SMC_CONNECTION_FAILED",
              "HELPER_MISSING",
              "HELPER_AUTHORIZATION_REQUIRED",
              "NO_CURRENT_FAN_EVIDENCE",
              "NO_CURVE_SENSOR_EVIDENCE",
              "CONTROL_NOT_ATTEMPTED",
              "CONTROL_REQUEST_SUCCEEDED",
              "CONTROL_REQUEST_FAILED"
            ]
          },
          "userConfirmedWorking": {
            "type": "boolean",
            "const": true
          },
          "failure": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "SMC_CONNECTION_FAILED",
                  "SMC_OPERATION_FAILED",
                  "SMC_INVALID_VALUE",
                  "UNLOCK_TIMEOUT",
                  "MODE_KEY_MISSING",
                  "INVALID_REQUEST",
                  "HELPER_TIMEOUT",
                  "HELPER_CONNECTION_FAILED",
                  "READBACK_NOT_MANUAL",
                  "HELPER_ERROR_UNCLASSIFIED"
                ]
              },
              "smcKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9! ]{4}$"
              },
              "resultCode": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "fanIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "durationMS": {
                "type": "integer",
                "minimum": 0,
                "maximum": 600000
              },
              "readbackManual": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              },
              "restoredAutomatic": {
                "type": "boolean"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "capability",
          "status",
          "reasonCode"
        ],
        "additionalProperties": false
      }
    },
    "selectedTemperatureSource": {
      "type": "string",
      "enum": [
        "maxChip",
        "cpu",
        "gpu",
        "ssd"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "reportID",
    "device",
    "capabilities",
    "selectedTemperatureSource"
  ],
  "additionalProperties": false,
  "title": "FanBar compatibility report v1",
  "description": "Strict upload allow-list. Additional semantic evidence checks are documented in services/compatibility/PRIVACY.md."
}
