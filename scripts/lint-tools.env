# Linter versions CI and the pre-commit hook use. A new SwiftFormat or SwiftLint
# release can add rules that flag code which passed yesterday, so both are pinned
# here and upgraded on purpose: bump a version and its checksum (the release
# asset's sha256, e.g. `gh api repos/realm/SwiftLint/releases/tags/<v>`), run
# `zsh scripts/install-lint-tools.sh`, fix what the new rules report, commit.
SWIFTFORMAT_VERSION=0.64.4
SWIFTFORMAT_SHA256=bb42fbfb0b9d5f1b8b83db3147087220ea414916fce8c5cf71abaea5ad5a3175
SWIFTLINT_VERSION=0.65.1
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
